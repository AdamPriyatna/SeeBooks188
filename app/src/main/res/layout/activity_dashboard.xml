
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F7FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SeeBooks"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#7C3AED" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="DIGITAL BOOK MANAGEMENT"
                    android:textSize="10sp"
                    android:textColor="#9994A8"
                    android:letterSpacing="0.12" />

            </LinearLayout>

            <TextView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:text="📚"
                android:textSize="26sp"
                android:gravity="center"
                android:background="#EDE9FE" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="YOUR PERSONAL LIBRARY"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#9B91B2"
            android:layout_marginTop="42dp" />

        <TextView
            android:id="@+id/tvWelcome188"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Welcome, User!"
            android:textSize="27sp"
            android:textStyle="bold"
            android:textColor="#242033"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Kelola dan nikmati koleksi buku pribadimu."
            android:textSize="14sp"
            android:textColor="#77738A"
            android:layout_marginTop="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="24dp"
            android:background="#7C3AED"
            android:elevation="4dp"
            android:layout_marginTop="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TOTAL KOLEKSI BUKU"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#EDE9FE"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvTotalBooks188"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0"
                android:textSize="54sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buku tersimpan di perpustakaanmu"
                android:textSize="12sp"
                android:textColor="#EDE9FE" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="QUICK ACCESS"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#9B91B2"
            android:layout_marginTop="34dp"
            android:layout_marginBottom="14dp" />

        <Button
            android:id="@+id/btnMyBooks188"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="📖  LIHAT KOLEKSI BUKU"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#7C3AED" />

        <Button
            android:id="@+id/btnLogout188"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="LOGOUT"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#DC2626"
            android:backgroundTint="#FEE2E2"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SeeBooks188 • Your Books, Your Story."
            android:textSize="11sp"
            android:textColor="#9994A8"
            android:gravity="center"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="12dp" />

    </LinearLayout>
</ScrollView>
